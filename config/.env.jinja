


# --------------------------------- Superset --------------------------------- #
# Variables that are predefined by superset. Needed as env vars on launch.

SUPERSET_SECRET_KEY={{ superset_secret_key }}
# randomly generate this key via 'openssl rand -base64 42'
SUPERSET_ADMIN={{ superset_admin }}
SUPERSET_PASSWORD={{ superset_password }}
SUPERSET_ADMIN_EMAIL={{ superset_admin_email }}
SUPERSET_LOAD_EXAMPLES=no

# Gunicorn processes and threads (now actually applied by start_superset.sh)
# Defaults target the production profile (4 CPU / 16GB RAM). Scale workers
# (not threads) and SUPERSET_APP_MEM_LIMIT together when you grow; threads
# bound how many in-process (duckdb) queries can run concurrently in the app.
FLASK_ENV=production
SERVER_WORKER_AMOUNT=4
SERVER_THREADS_AMOUNT=20
# Celery worker processes (scale together with SUPERSET_WORKER_MEM_LIMIT).
# Kept at 2 on 4 cores: each report task can occupy 2 cores itself
# (duckdb threads + Chromium rendering).
CELERY_WORKER_CONCURRENCY=2
# gunicorn kills requests after this; keep >= SUPERSET_WEBSERVER_TIMEOUT (180)
GUNICORN_TIMEOUT=180
#
# --- Tight profile (4GB / 2 vCPU host) ---
# SERVER_WORKER_AMOUNT=2
# SERVER_THREADS_AMOUNT=10
# CELERY_WORKER_CONCURRENCY=1
# Log level for superset + celery (INFO for production, DEBUG when troubleshooting)
LOG_LEVEL=INFO

# Mapbox integration (map visualizations in superset require a mapbox token)
MAPBOX_API_KEY=

NO_PROXY=superset-app,superset-postgres,superset-redis,superset-init,superset-worker,superset-beat,localhost,127.0.0.1
# Needed for intra-container communication.
# e.g. so that superset commands (which should work offline, such as local email reports)
# work, even when the whole stack stis behind a proxy.

# ---------------------------- superset_config.py ---------------------------- #
# Variables that are picked up in our example superset_config.py

# Mailing
SMTP_USER={{ smtp_user }}
SMTP_HOST={{ smtp_host }}
SMTP_PORT={{ smtp_port }}
SMTP_PASSWORD={{ smtp_password }}

# The following vars are used in superset_config, but are shared with other services
# and define further below
# DOMAIN
# AUTH_TYPE
# USE_ROLE_BASED_REDIRECTS
# POSTGRES_*
# REDIS_*

# --------------------------------- Keycloak --------------------------------- #

# Authentication.
# This is a superset variable, used in our example superset_config.py.
AUTH_TYPE=AUTH_DB # set to AUTH_OAUTH to enable Keycloak SSO

# When using keycloak, you will likely have your own CA.
# In this case, we need to tell flask and apt to trust it.
# The two vars are the standard ones used by flask and apt.
REQUESTS_CA_BUNDLE=/app/superset/auth_keycloak/custom-ca.crt
SSL_CERT_FILE=/app/superset/auth_keycloak/custom-ca.crt
USE_ROLE_BASED_REDIRECTS="false"

# ------------------------------ Superset Helper ----------------------------- #

# Postgres
POSTGRES_DB=superset   # these should not be changed, there is a bug with superset db init.
POSTGRES_USER=superset # these should not be changed, there is a bug with superset db init.
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_HOST=superset-postgres
POSTGRES_PORT=5432
# Note on ports:
# Container-to container communication uses the native ports (not the ones exposed to the host!)
# The port variables only affect the port mapping to the host machine.

# Redis Configuration
# Single instance for caches and the celery broker. It runs volatile-lru so
# only TTL'd cache keys are evicted — queued celery tasks are never dropped.
# NOTE: the data cache stores actual chart/query result payloads, so size
# REDIS_MAXMEMORY generously; maxmemory is a cap, not a reservation.
REDIS_HOST=superset-redis
REDIS_PORT=6379
REDIS_PASSWORD={{ redis_password }}
REDIS_SSL=false

# ------------------------------ Memory budget ------------------------------ #
# Standard profile, sums to ~5.5g of LIMITS — comfortable on a 6-8GB host.
# Limits are ceilings, not reservations: steady-state usage sits well below
# this (redis maxmemory in particular is a cap the cache grows into, not an
# allocation), the ceilings just decide who the OOM killer visits first
# instead of taking down the host.
#
#   caddy 256m + app 3g + postgres 512m + redis 2g + worker 2g + beat 256m
#   (+ init 1g, transient during startup only)
#   => plan for an 8-10GB host with this profile.
#
# DuckDB marts: duckdb runs IN-PROCESS inside superset-app and the celery
# worker — those containers ARE the query engine. Their limits must cover:
#   baseline + (duckdb memory_limit x concurrent queries)
# e.g. app 3g ~= 1g gunicorn + 4 concurrent queries x 512MB.
# In each Superset duckdb connection (Advanced -> Engine Parameters), ALWAYS
# set an explicit cap — duckdb otherwise sizes itself to HOST RAM and gets
# the container OOM-killed:
#   {"connect_args": {"config": {"memory_limit": "512MB", "threads": 2,
#     "temp_directory": "/app/superset_home/duckdb_tmp"}, "read_only": true}}
# (read_only avoids file-lock conflicts between app, worker and your mart
# writer; temp_directory lets big queries spill to disk instead of dying.)
#
# Redis holds the dataset/chart result caches — size it generously, evictions
# turn into re-queries against your source databases. Keep maxmemory at ~1/2
# of REDIS_MEM_LIMIT (fragmentation + AOF-rewrite fork headroom). To check the
# sizing on a running system:
#   docker compose exec superset-redis redis-cli INFO stats | grep -E 'evicted_keys|keyspace'
# rising evicted_keys or a poor hit/miss ratio means: raise REDIS_MAXMEMORY.
CADDY_MEM_LIMIT=256m
SUPERSET_APP_MEM_LIMIT=3g
SUPERSET_INIT_MEM_LIMIT=1g
SUPERSET_WORKER_MEM_LIMIT=2g
SUPERSET_WORKER_SHM_SIZE=1gb
SUPERSET_BEAT_MEM_LIMIT=256m
POSTGRES_MEM_LIMIT=512m
REDIS_MAXMEMORY=1gb
REDIS_MEM_LIMIT=2g
#
# --------------- Tight profile for a small host (4GB / 2 vCPU) --------------- #
# Uncomment ALL of the below together (and adjust the values above) — the
# profile only works as a set: the concurrency caps are what make the memory
# ceilings safe, not the other way around.
#
# Concurrency (the real protection on 2 vCPU):
#   CELERY_WORKER_CONCURRENCY=1 is the most important line — one screenshot
#   render plus one duckdb query already saturates the machine.
# SERVER_WORKER_AMOUNT=2
# SERVER_THREADS_AMOUNT=10
# CELERY_WORKER_CONCURRENCY=1
#
# Memory ceilings (~3.8g of limits; slight over-commit is intentional — the
# concurrency caps exclude the scenario where everything peaks at once):
# CADDY_MEM_LIMIT=128m
# SUPERSET_APP_MEM_LIMIT=1536m
# SUPERSET_INIT_MEM_LIMIT=1g
# SUPERSET_WORKER_MEM_LIMIT=1g
# SUPERSET_WORKER_SHM_SIZE=512m
# SUPERSET_BEAT_MEM_LIMIT=192m
# POSTGRES_MEM_LIMIT=384m
# REDIS_MAXMEMORY=256mb
# REDIS_MEM_LIMIT=512m
#
# Small redis = lower cache hit rates; misses just re-query the source,
# they are not errors.
#
# With duckdb marts, ALSO tighten every connection's engine parameters
# (Superset UI, Advanced -> Engine Parameters) — this cap is what makes the
# over-commit safe:
#   {"connect_args": {"config": {"memory_limit": "256MB", "threads": 1,
#     "temp_directory": "/app/superset_home/duckdb_tmp"}, "read_only": true}}
#
# If reports OOM on this profile: bump SUPERSET_WORKER_MEM_LIMIT to 1536m and
# take it from SUPERSET_APP_MEM_LIMIT — screenshots are spikier than queries.
# ----------------------------------------------------------------------------- #
#
# Scaling up (production, e.g. 16GB / 4 CPU — pairs with duckdb engine params
# of memory_limit 512MB / threads 2):
# SERVER_WORKER_AMOUNT=4, SERVER_THREADS_AMOUNT=20, CELERY_WORKER_CONCURRENCY=2,
# SUPERSET_APP_MEM_LIMIT=4g, SUPERSET_WORKER_MEM_LIMIT=3g,
# SUPERSET_WORKER_SHM_SIZE=2gb, POSTGRES_MEM_LIMIT=1g,
# REDIS_MAXMEMORY=2gb, REDIS_MEM_LIMIT=4g
# Leave a few GB unallocated: the page cache serves repeat duckdb file scans
# from RAM.

# ----------------------------------- Caddy ---------------------------------- #
# if using letsencrypt with traefik
# If you do not use localhost here, you might have to edit /etc/hosts.
DOMAIN_NAME={{ domain_name }}
DOMAIN=https://{{ domain_name }}

# Reverse proxy TLS mode (used by docker-compose.caddy.yml)
# - TLS_MODE=acme       => public certificate via ACME (Let's Encrypt), ACME_EMAIL must be set!
# - TLS_MODE=selfsigned => internal PKI (coasti CA root + intermediate)
# - TLS_MODE=internal   => use a custom certificate/key (mounted into the caddy container)
ACME_EMAIL={{ superset_admin_email }}
TLS_MODE=selfsigned

# Custom certificate mode settings (TLS_MODE=internal)
# The docker-compose.caddy.yml mounts ./certs -> /etc/caddy/certs (read-only)
TLS_CERT_FILE=/etc/caddy/certs/fullchain.pem
TLS_KEY_FILE=/etc/caddy/certs/privkey.pem


