{
	# Uses a public ACME CA (Let's Encrypt / ZeroSSL) automatically.
	email {$ACME_EMAIL}
}

{$DOMAIN_NAME} {
	reverse_proxy superset-app:8088 {
        # Timeouts for long-running operations
        transport http {
            read_timeout 3600s
            write_timeout 3600s
            # Idle upstream connections (default 2m). Must stay BELOW
            # gunicorn's --keep-alive (GUNICORN_KEEPALIVE, default 75s) so
            # Caddy is always the side that closes a pooled connection.
            # The other way round races gunicorn's close and surfaces as
            # sporadic 502s on non-retryable requests (POST chart/data).
            keepalive 60s
        }
    }
}

test-{$DOMAIN_NAME} {
	reverse_proxy superset-app-test:8088 {
        # Timeouts for long-running operations
        transport http {
            read_timeout 3600s
            write_timeout 3600s
            # Idle upstream connections (default 2m). Must stay BELOW
            # gunicorn's --keep-alive (GUNICORN_KEEPALIVE, default 75s) so
            # Caddy is always the side that closes a pooled connection.
            # The other way round races gunicorn's close and surfaces as
            # sporadic 502s on non-retryable requests (POST chart/data).
            keepalive 60s
        }
    }
}
